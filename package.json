{
  "name": "@seanalunni/tree-sitter-cil",
  "version": "1.0.0",
  "description": ".NET's common intermediate language parser",
  "author": "AFatNiBBa",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "tree-sitter playground",
    "prestart": "npm run build",
    "save": "npm run build && npm publish --access public",
    "build": "npm run generate && tree-sitter build --wasm",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "ssl": "echo ssl-revoke-best-effort >> %userprofile%/.curlrc"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.27.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFatNiBBa/tree-sitter-cil.git"
  },
  "files": [
    "*.wasm"
  ],
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "cil"
  ]
}